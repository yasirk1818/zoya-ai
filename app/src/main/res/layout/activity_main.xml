<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Background gradient blobs -->
    <View
        android:id="@+id/blobViolet"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp"
        android:background="@drawable/bg_gradient_violet" />

    <View
        android:id="@+id/blobPink"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_gradient_pink" />

    <!-- Animated Visualizer -->
    <com.zoya.ai.ZoyaVisualizerView
        android:id="@+id/visualizer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Chat Messages Overlay -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="90dp"
        android:clipToPadding="false"
        android:padding="16dp"
        android:scrollbars="none"
        android:overScrollMode="never" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_marginTop="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Logo -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_logo_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/rajdhani_bold"
                android:text="Z"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/rajdhani_bold"
            android:paddingStart="10dp"
            android:text="Zoya"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Mute toggle -->
        <FrameLayout
            android:id="@+id/btnMute"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/muteIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔊"
                android:textSize="18sp" />
        </FrameLayout>

        <!-- Clear chat -->
        <FrameLayout
            android:id="@+id/btnClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🗑"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Status: Listening indicator (top-right) -->
    <LinearLayout
        android:id="@+id/listeningIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_status_indicator"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/listeningDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_logo_circle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_medium"
            android:text="Listening..."
            android:textColor="@color/white_70"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Status: Replying indicator (top-left) -->
    <LinearLayout
        android:id="@+id/replyingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="96dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_status_indicator"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="@color/white_70" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_medium"
            android:text="Replying..."
            android:textColor="@color/white_70"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Footer Controls -->
    <LinearLayout
        android:id="@+id/footerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingHorizontal="16dp">

        <!-- Text input bar (hidden by default) -->
        <LinearLayout
            android:id="@+id/textInputBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_text_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/textInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/rajdhani_regular"
                android:hint="Type a message..."
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/white_30"
                android:textSize="15sp" />

            <FrameLayout
                android:id="@+id/btnSend"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_send_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="➤"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Button row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Keyboard toggle -->
            <FrameLayout
                android:id="@+id/btnKeyboard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/keyboardIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⌨"
                    android:textSize="20sp" />
            </FrameLayout>

            <!-- Session button -->
            <TextView
                android:id="@+id/btnSession"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_session_button"
                android:fontFamily="@font/rajdhani_semibold"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:paddingHorizontal="32dp"
                android:text="Start Session"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- API Key Overlay -->
    <FrameLayout
        android:id="@+id/apiKeyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_api_key_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Logo -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_logo_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/rajdhani_bold"
                    android:text="Z"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:text="Zoya AI Chat"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/rajdhani_regular"
                android:text="Admin Panel URL ya API Key dalo"
                android:textColor="@color/white_50"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/apiUrlInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_api_key_input"
                android:fontFamily="monospace"
                android:hint="Admin Panel API URL (optional)"
                android:inputType="textUri"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white_30"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="— ya direct API key —"
                android:textColor="@color/white_30"
                android:textSize="12sp"
                android:layout_gravity="center" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_api_key_input"
                android:fontFamily="monospace"
                android:hint="Gemini API Key"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white_30"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSaveApiKey"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_api_key_button"
                android:fontFamily="@font/rajdhani_bold"
                android:gravity="center"
                android:text="Zoya se Miliye →"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Microphone Permission Dialog -->
    <FrameLayout
        android:id="@+id/permissionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/bg_permission_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Mic off icon -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_mic_off_circle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎙"
                    android:textSize="24sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:text="Microphone Permission Required"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/rajdhani_regular"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="1. Go to Settings\n2. Tap App Permissions\n3. Enable Microphone\n4. Come back and tap Refresh"
                android:textColor="@color/white_50"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPermissionClose"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_icon_button"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:gravity="center"
                    android:text="Close"
                    android:textColor="@color/white_70"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnPermissionRefresh"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_api_key_button"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:gravity="center"
                    android:text="Refresh"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
